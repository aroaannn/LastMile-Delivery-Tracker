# Server
PORT=5000
NODE_ENV=development

# Database (Postgres). Example for local docker or a hosted free-tier db (Neon/Supabase/Railway)
DATABASE_URL="postgresql://user:password@localhost:5432/lastmile?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Email (any free-tier SMTP works, e.g. Gmail app password, Mailtrap, Ethereal, Brevo)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-pass"
SMTP_FROM="Last-Mile Tracker <no-reply@lastmile.test>"

# CORS
CLIENT_ORIGIN="http://localhost:5173"
